{
    "app-id" : "io.github.misakisata.Foliate",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "49",
    "sdk" : "org.gnome.Sdk",
    "command": "foliate-personal",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--env=LANGUAGE=zh_CN:zh",
        "--filesystem=xdg-run/speech-dispatcher:ro",
        "--add-policy=Tracker3.dbus:org.freedesktop.Tracker3.Miner.Files=tracker:Documents"
    ],
    "modules" : [
        {
            "name" : "foliate",
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "dir",
                    "path": ".",
                    "skip": [
                        ".git",
                        ".flatpak-builder",
                        "_build",
                        "build",
                        "dist",
                        "node_modules",
                        "src/foliate-js/.git"
                    ]
                }
            ]
        }
    ]
}
